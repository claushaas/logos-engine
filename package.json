{
	"dependencies": {
		"commander": "^14.0.3",
		"ink": "^7.0.2",
		"react": "^19.2.6",
		"yaml": "^2.8.4",
		"zod": "^4.4.3"
	},
	"description": "Conversational intake and compilation engine for AI-structured documentation — Pi extension MVP.",
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@earendil-works/pi-coding-agent": "^0.75.4",
		"@types/node": "^25.6.2",
		"@types/react": "^19.2.14",
		"@vitest/coverage-v8": "^4.1.5",
		"ink-testing-library": "^4.0.0",
		"markdownlint-cli": "^0.48.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"default": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist",
		"profiles",
		"docs",
		"README.md",
		"LICENSE",
		"SECURITY.md",
		"CONTRIBUTING.md",
		"CODE_OF_CONDUCT.md"
	],
	"keywords": [
		"documentation",
		"tui",
		"ai",
		"typescript"
	],
	"license": "MIT",
	"main": "./dist/index.js",
	"name": "logos-engine",
	"packageManager": "pnpm@10.33.2",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:validation && pnpm build && pnpm smoke:cli && pnpm smoke:package",
		"check:validation": "vitest run tests/validation-gate.test.ts",
		"format": "pnpm format:biome",
		"format:biome": "biome check --write --unsafe .",
		"lint": "pnpm lint:biome && pnpm lint:md",
		"lint:biome": "biome check .",
		"lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
		"nfr:evidence": "node scripts/nfr-evidence.js",
		"security:check": "node scripts/security-check.js",
		"smoke:cli": "node scripts/smoke-cli.js",
		"smoke:package": "node scripts/smoke-package.js",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"version": "0.1.0"
}
