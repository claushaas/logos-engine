{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"exactOptionalPropertyTypes": true,
		"forceConsistentCasingInFileNames": true,
		"jsx": "react-jsx",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmitOnError": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUncheckedIndexedAccess": true,
		"outDir": "dist",
		"paths": {
			"@logos/application": ["./src/application"],
			"@logos/application/*": ["./src/application/*"],
			"@logos/contracts": ["./src/contracts"],
			"@logos/contracts/*": ["./src/contracts/*"],
			"@logos/conversation-runtime": ["./src/conversation-runtime"],
			"@logos/conversation-runtime/*": ["./src/conversation-runtime/*"],
			"@logos/diagnostics": ["./src/diagnostics"],
			"@logos/diagnostics/*": ["./src/diagnostics/*"],
			"@logos/llm": ["./src/llm"],
			"@logos/llm/*": ["./src/llm/*"],
			"@logos/materialization": ["./src/materialization"],
			"@logos/materialization/*": ["./src/materialization/*"],
			"@logos/outputs": ["./src/outputs"],
			"@logos/outputs/*": ["./src/outputs/*"],
			"@logos/persistence": ["./src/persistence"],
			"@logos/persistence/*": ["./src/persistence/*"],
			"@logos/profiles": ["./src/profiles"],
			"@logos/profiles/*": ["./src/profiles/*"],
			"@logos/prompt-orchestration": ["./src/prompt-orchestration"],
			"@logos/prompt-orchestration/*": ["./src/prompt-orchestration/*"],
			"@logos/shared": ["./src/shared"],
			"@logos/shared/*": ["./src/shared/*"],
			"@logos/state-engine": ["./src/state-engine"],
			"@logos/state-engine/*": ["./src/state-engine/*"],
			"@logos/tui": ["./src/tui"],
			"@logos/tui/*": ["./src/tui/*"],
			"@logos/validation": ["./src/validation"],
			"@logos/validation/*": ["./src/validation/*"]
		},
		"rootDir": "src",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
