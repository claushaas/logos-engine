{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"properties": {
		"confidence": { "type": "object" },
		"execution": {
			"properties": {
				"artifacts": { "type": "array" },
				"decisions": { "type": "array" },
				"initiatives": { "type": "array" },
				"items": { "type": "array" },
				"milestones": { "type": "array" },
				"risks": { "type": "array" },
				"roadmaps": { "type": "array" },
				"workstreams": { "type": "array" }
			},
			"required": [
				"roadmaps",
				"milestones",
				"workstreams",
				"initiatives",
				"items"
			],
			"type": "object"
		},
		"exports": { "type": "object" },
		"generatedAt": { "type": "string" },
		"id": { "type": "string" },
		"metadata": { "type": "object" },
		"project": {
			"properties": {
				"description": { "type": "string" },
				"id": { "type": "string" },
				"name": { "type": "string" }
			},
			"required": ["id", "name"],
			"type": "object"
		},
		"source": {
			"properties": {
				"normativeDocuments": { "items": { "type": "string" }, "type": "array" }
			},
			"required": ["normativeDocuments"],
			"type": "object"
		},
		"version": { "type": "string" }
	},
	"required": [
		"id",
		"version",
		"project",
		"generatedAt",
		"source",
		"execution"
	],
	"type": "object"
}
