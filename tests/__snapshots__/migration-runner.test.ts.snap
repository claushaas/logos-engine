// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`migration plan snapshots > snapshots blocked future-version plan 1`] = `"blocked"`;

exports[`migration plan snapshots > snapshots blocked future-version plan 2`] = `true`;

exports[`migration plan snapshots > snapshots migration plan for older version 1`] = `"planned"`;

exports[`migration plan snapshots > snapshots migration plan for older version 2`] = `1`;

exports[`migration plan snapshots > snapshots migration plan for older version 3`] = `
[
  "migrate-v3.0.0-to-v3.1.0",
]
`;

exports[`migration plan snapshots > snapshots no-op plan for current version 1`] = `"not_needed"`;

exports[`migration plan snapshots > snapshots no-op plan for current version 2`] = `false`;

exports[`migration plan snapshots > snapshots no-op plan for current version 3`] = `[]`;
